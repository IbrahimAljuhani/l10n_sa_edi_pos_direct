<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- إخفاء QR من الهيدر عند direct mode + إخفاء Powered by Odoo -->
    <t t-inherit="l10n_sa_pos.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//img[@id='qrcode']" position="replace">
            <img t-if="props.data.qr_code and !props.data.zatca_direct"
                 id="qrcode"
                 t-att-src="props.data.qr_code"
                 class="pos-receipt-qrcode"/>
        </xpath>
    </t>

    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">

        <!-- إخفاء Powered by Odoo من الإيصال -->
        <xpath expr="//p[text()='Powered by Odoo']" position="replace"/>

        <!-- إضافة QR في الأسفل بعد div الذي يحتوي order-date -->
        <xpath expr="//div[@id='order-date']/.." position="after">
            <t t-if="props.data.zatca_direct and props.data.qr_code">
                <div class="zatca-qr-bottom">
                    <img t-att-src="props.data.qr_code"
                         class="zatca-qr-img"
                         alt="ZATCA QR Code"/>
                </div>
            </t>
        </xpath>

    </t>

</templates>
